<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_dialog_info"
        android:label="Lucid Watch"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!--
            false: the watch app cannot work on its own. The phone sets up the night session,
            imports sleep stages from Samsung Health and plays the audio half of a TLR cue,
            so the watch requires the companion app to be installed.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".ui.WatchMainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.WatchTrackingForegroundService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <service
            android:name=".service.WatchWearableListenerService"
            android:exported="true">

            <!-- Session commands from the phone. All protocol paths live under /lucid. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/lucid" />
            </intent-filter>

            <!-- Phone reachability, used to drain the offline event queue after a reconnect. -->
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/lucid_phone_companion" />
            </intent-filter>
        </service>

    </application>

</manifest>
